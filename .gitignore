# Public source allowlist. Everything is excluded unless named here, so a new
# top-level path or file type has to be added deliberately.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/CMakeLists.txt
!/flake.nix
!/flake.lock

!/src/
/src/*
!/src/*.cpp
!/src/*.h

!/helper/
/helper/*
!/helper/*.cpp

!/qml/
/qml/*
!/qml/*.qml

!/tests/
/tests/*
!/tests/*.cpp
!/tests/*.h

!/scripts/
/scripts/*
!/scripts/*.sh

!/assets/
/assets/*
!/assets/io.github.yappologistic.Cohort.desktop
!/assets/io.github.yappologistic.Cohort.metainfo.xml
!/assets/io.github.yappologistic.Cohort.policy.in
!/assets/io.github.yappologistic.Cohort.svg
!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/cohort-fans.png

!/licenses/
/licenses/*
!/licenses/*.txt

!/packaging/
/packaging/*
!/packaging/legion_laptop.conf
!/packaging/arch/
/packaging/arch/*
!/packaging/arch/PKGBUILD
!/packaging/fedora/
/packaging/fedora/*
!/packaging/fedora/cohort.spec

# Never publish private state, credentials, build products, captures or
# editor and assistant files, even inside an allowed directory.
build*/
result
result-*
*.log
*.user
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.env
.env.*
*.pem
*.key
*.p12
*.pfx
cookies*
credentials*
secrets*
# Cohort keeps its settings in the XDG config directory, never in the tree,
# but a stray copy must not be committed either.
cohort.conf
verify-out/
.DS_Store
.claude/
.codex/
.agents/
.idea/
.vscode/

# Personal media, captures, archives and key material, wherever they land.
# The allowlist above already keeps them out; these hold even if it is
# widened by mistake. A new README image is added by name above.
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.wav
*.flac
*.mp3
*.zip
*.tar
*.tar.*
*.zst
*.7z
*.pkg.tar.*
*.ko
*.gpg
*.asc
*.ovpn
id_rsa*
id_ed25519*
*.kdbx
.netrc
.git-credentials
hosts.yml

# README is the only Markdown file in the public repository.
*.[mM][dD]
*.[mM][aA][rR][kK][dD][oO][wW][nN]
!/README.md
